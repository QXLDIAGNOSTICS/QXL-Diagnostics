# Workspace-level
.dart_tool/
.idea/
*.iml
/dist/
/build/

# Per-developer environment files (may hold Firebase/staging values) — both apps.
apps/*/env/local.json
apps/*/env/*.local.json
apps/*/env/staging.json

# Signing material and platform Firebase files — never commit.
apps/*/android/key.properties
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
